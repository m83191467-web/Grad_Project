rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin';
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && resource.data.driverId == request.auth.uid) ||
        (signedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats']) &&
         resource.data.availableSeats is number &&
         request.resource.data.availableSeats is number &&
         resource.data.availableSeats > 0 &&
         request.resource.data.availableSeats == resource.data.availableSeats - 1);
    }

    match /trips/{tripId} {
      allow read: if signedIn() &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid || isAdmin());
      allow create: if signedIn() &&
        request.resource.data.passengerId == request.auth.uid;
      allow update: if isAdmin() ||
        (signedIn() && resource.data.passengerId == request.auth.uid &&
         unchanged('passengerId') && unchanged('driverId') &&
         unchanged('fareAmount') && unchanged('createdAt')) ||
        (signedIn() && resource.data.driverId == request.auth.uid &&
         unchanged('passengerId') && unchanged('driverId') &&
         unchanged('fareAmount') && unchanged('createdAt'));
      allow delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if signedIn();
      allow write: if isAdmin() || isOwner(driverId);
    }
  }
}
